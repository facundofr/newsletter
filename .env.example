# Copiá este archivo a .env y completá los valores.
# Si un valor tiene caracteres como $ # o espacios, ponelo entre comillas simples: 'as$d#f'

# ---- Dominio ----
DOMAIN=tudominio.com
SITE_URL=https://tudominio.com

# ---- Base de datos ----
# Usá solo letras y números (generalo con: openssl rand -hex 24)
POSTGRES_PASSWORD=cambiame
# Solo para desarrollo local (en Docker se arma automáticamente)
DATABASE_URL=postgresql://newsletter:cambiame@localhost:5432/newsletter

# ---- Acceso al panel /admin ----
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD='una-contraseña-larga-y-segura'
# 32+ caracteres al azar (generalo con: openssl rand -hex 32)
AUTH_SECRET=

# ---- Email (opcional) ----
# Para enviar tus artículos a los suscriptores. Creá una cuenta gratis en https://resend.com,
# verificá tu dominio y pegá la API key. Si lo dejás vacío, los suscriptores se guardan igual.
RESEND_API_KEY=
EMAIL_FROM='Tu Nombre <newsletter@tudominio.com>'
